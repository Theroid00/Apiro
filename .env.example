# Copy to .env and `source .env` (or export these in your shell) before
# running Apiro. There's no .env auto-loader bundled (no python-dotenv
# dependency) — these are read directly via os.environ.get() in
# apiro/config.py, so they only take effect if they're actually present
# in the process environment.

# Base URL of your local Ollama server.
OLLAMA_BASE_URL=http://localhost:11434

# Model tag to use for all LLM calls (entropy scoring, contradiction
# judging, expansion, synthesis). Must already be pulled: `ollama pull <tag>`.
PRIMARY_MODEL=llama3.1:8b

# Fixed decoding settings used by live evaluations.
APIRO_MODEL_TEMPERATURE=0.2
APIRO_MODEL_SEED=7
APIRO_JSON_NUM_PREDICT=768

# Maximum Ollama requests allowed in flight across one Apiro process.
APIRO_MAX_MODEL_CONCURRENCY=2

# Reasoning engine used by CLI, web, and live evaluations. "simple" is the
# efficient default, "investigator" is bounded multi-round reasoning, and
# "legacy" retains the original entropy-first traversal for comparisons.
APIRO_REASONING_MODE=simple

# Bounded-engine prompt limits. Raising these can improve recall on long cases
# at the cost of extraction, retrieval, and prompt-processing time.
APIRO_SIMPLE_MAX_FACTS=12
APIRO_SIMPLE_RAG_TOP_K=6
APIRO_SIMPLE_MAX_CONTEXT_CHARS=12000
# Permit one targeted retrieval/revision when deterministic quality checks fail.
APIRO_SIMPLE_CORRECTIVE_PASS=true

# Complete investigator-mode hard limits.
APIRO_INVESTIGATOR_MAX_FACTS=20
APIRO_INVESTIGATOR_MAX_CANDIDATES=6
APIRO_INVESTIGATOR_MAX_ROUNDS=3
APIRO_INVESTIGATOR_MAX_RETRIEVALS=6
APIRO_INVESTIGATOR_MAX_MODEL_CALLS=4
APIRO_INVESTIGATOR_MAX_GRAPH_NODES=50
APIRO_INVESTIGATOR_MAX_ADJUDICATIONS=1
# Optional persisted research components. Defaults live under data/.
APIRO_CONCEPT_GRAPH_PATH=data/concept_graph.json
APIRO_ACTION_POLICY_PATH=data/action_policy.json
