# =========================
# Local caches & downloaded corpora
# =========================
# Rebuildable from apiro/corpus/build_corpus.py; hundreds of MB.
data/chroma_db/
data/corpus/
data/ontology/
data/logs/

# Source datasets that are not ours to redistribute. Re-fetch with
# `python scripts/fetch_datasets.py` — DDXPlus is CC-BY and CUPCase is public,
# but both are large and belong to their upstreams, not to this repo.
data/PMC-Patients-V2.json
data/datasets/

# =========================
# Generated run artifacts
# =========================
# Per-case traversal traces, one file per case per run.
data/traversal_log_*.jsonl
data/runs/*/logs/
data/graph_*.json
data/graph_*.html
data/corpus_stats.json
data/smoke_results.json
figures/

# Raw captured console output from a benchmark run.
data/*benchmark_output.txt

# NOTE: benchmark *inputs* and *results* are deliberately NOT ignored.
# The previous version of this file ignored `data/*.json` wholesale with a
# single `!data/pmc_cases.json` exception, which silently excluded
# data/niah_cases.json, data/niah_eval_results.json and
# data/calibration_eval_results.json — i.e. the case definitions and every
# published number in the README. Reproducing a reported figure requires the
# case set it was computed on, so these are tracked.
#
# It also carried bare `*.html` and `*.jsonl` rules that applied repo-wide,
# not just under data/, so any documentation page or fixture anywhere in the
# tree would have been dropped without warning.

# =========================
